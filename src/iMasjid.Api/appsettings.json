{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "https://localhost:5174/",
    "Audience": [
      "http://localhost:5174/",
      "https://localhost:7199"
    ],
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Security": {
    "OtpHashKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7199",
      "https://localhost:5174",
      "https://localhost:5173",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Caching": {
    "DefaultExpirationMinutes": 30
  },
  "RateLimiting": {
    "EnableRateLimiting": true,
    "RealIpHeader": "X-Forwarded-For",
    "DefaultRule": {
      "PeriodSeconds": 60,
      "Limit": 100,
      "QueueLimit": 10
    },
    "EndpointRules": [
      {
        "Endpoint": "POST:/api/auth/*",
        "PeriodSeconds": 300,
        "Limit": 20,
        "QueueLimit": 0
      },
      {
        "Endpoint": "POST:/api/users*",
        "PeriodSeconds": 300,
        "Limit": 20,
        "QueueLimit": 0
      },
      {
        "Endpoint": "POST:/api/roles*",
        "PeriodSeconds": 300,
        "Limit": 20,
        "QueueLimit": 0
      },
      {
        "Endpoint": "POST:/api/menus*",
        "PeriodSeconds": 300,
        "Limit": 20,
        "QueueLimit": 0
      },
      {
        "Endpoint": "POST:/api/businessactions*",
        "PeriodSeconds": 300,
        "Limit": 20,
        "QueueLimit": 0
      },
      {
        "Endpoint": "POST:/api/applicationsettings*",
        "PeriodSeconds": 300,
        "Limit": 20,
        "QueueLimit": 0
      }
    ]
  },
  "Email": {
    "SmtpServer": "smtp.example.com",
    "Port": 587,
    "SenderName": "iMasjid Security Team",
    "SenderEmail": "noreply@imasjid.com",
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "Enabled": false
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "DashboardUsername": "",
    "DashboardPassword": "",
    "WorkerCount": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
