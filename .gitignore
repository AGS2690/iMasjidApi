# =============================================================
# .gitignore for ASP.NET Core / Clean Architecture Project
# =============================================================

# ---------------------------------------------------------------
# 🔐 SENSITIVE – NEVER PUSH THESE
# ---------------------------------------------------------------

# Local appsettings with real secrets (DB passwords, JWT keys, SMTP)
src/**/appsettings.Development.json
src/**/appsettings.Production.json
src/**/appsettings.Staging.json

# .NET User Secrets (stored by dotnet user-secrets)
src/**/secrets.json

# Environment variable files
.env
.env.*
*.env

# Azure Key Vault / credential files
local.settings.json

# ---------------------------------------------------------------
# 🔨 BUILD OUTPUTS
# ---------------------------------------------------------------

# Compiled output
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ---------------------------------------------------------------
# 🗃️ .NET / NUGET
# ---------------------------------------------------------------

# NuGet packages directory
*.nupkg
*.snupkg
**/[Pp]ackages/
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# NuGet cache / lock files
project.lock.json
project.fragment.lock.json
artifacts/

# ---------------------------------------------------------------
# 🖥️ VISUAL STUDIO
# ---------------------------------------------------------------

# VS solution user files (contain local machine-specific settings)
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio temp/crash files
.vs/
*.VC.db
*.VC.opendb

# VS cache / options
.vs/
!.vs/ProjectSettings.json

# Backup files
*.bak
*.tmp
*.temp

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# ---------------------------------------------------------------
# 🧪 TEST OUTPUTS
# ---------------------------------------------------------------

# Test result files
TestResults/
*.trx
*.coverage
*.coveragexml
[Cc]overage*/
_CodeCoverageReport*/
*.testlog

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# ---------------------------------------------------------------
# 📋 ENTITY FRAMEWORK / DATABASE
# ---------------------------------------------------------------

# EF Core migrations backup
*.migrations.bak

# SQL Server LocalDB files (never commit local DB files)
*.mdf
*.ldf
*.ndf

# SQLite dev databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------
# 📦 PUBLISH / DEPLOYMENT
# ---------------------------------------------------------------

# Publish output
publish/
[Pp]ublish/
PublishProfiles/

# Web Deploy
*.pubxml
*.pubxml.user
*.publishproj

# Terraform / infra state
*.tfstate
*.tfstate.backup
.terraform/

# Docker
.dockerignore

# ---------------------------------------------------------------
# 🛠️ TOOLS / IDE
# ---------------------------------------------------------------

# JetBrains Rider
.idea/
*.sln.iml

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Rider
.idea/

# ---------------------------------------------------------------
# 📝 MISC
# ---------------------------------------------------------------

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------
# ✅ KEEP THESE (explicit allow)
# ---------------------------------------------------------------

# Keep the base appsettings (no secrets, just defaults/structure)
!src/**/appsettings.json

# Keep migration files generated by EF Core
!src/**/Migrations/**/*.cs

# Keep scaffold scripts
!src/**/Scaffolding/**
!src/**/Scripts/**
